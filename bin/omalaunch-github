#!/usr/bin/env python3
"""Read GitHub state through gh and emit bounded Omalaunch menu documents."""

import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from urllib.parse import urlparse

LIMIT = 24
TIMEOUT = 4
SELF = os.path.realpath(__file__)
STATE_PATH = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                          "omarchy", "omalaunch", "extensions", "quantumfire.github.json")
STAR_KEY = re.compile(r"^(?:general:(?:repositories|issues|pull-requests|notifications)|repo:[^:]+/[^:]+:(?:overview|issues|pull-requests|notifications|actions))$")


def load_stars():
    try:
        with open(STATE_PATH, encoding="utf-8") as state_file:
            value = json.load(state_file)
        stars = value.get("stars", []) if isinstance(value, dict) else []
        return {item for item in stars if isinstance(item, str) and STAR_KEY.fullmatch(item)}
    except (OSError, json.JSONDecodeError):
        return set()


def save_stars(stars):
    directory = os.path.dirname(STATE_PATH)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    temporary = STATE_PATH + f".tmp.{os.getpid()}"
    with open(temporary, "w", encoding="utf-8") as state_file:
        json.dump({"version": 1, "stars": sorted(stars)}, state_file, separators=(",", ":"))
        state_file.write("\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, STATE_PATH)


def set_star(key, enabled):
    if not STAR_KEY.fullmatch(key) or enabled not in ("true", "false"):
        fail("invalid star request")
    stars = load_stars()
    if enabled == "true":
        stars.add(key)
    else:
        stars.discard(key)
    save_stars(stars)


def starrable(row, key, starred_label):
    starred = key in load_stars()
    row = dict(row)
    row["id"] = key
    row["starred"] = starred
    row["starredLabel"] = starred_label
    row["starAction"] = "star"
    row["actions"] = list(row.get("actions", [])) + [{
        "id": "star", "label": "Remove from top level" if starred else "Add to top level",
        "command": [SELF, "set-star", key, "false" if starred else "true"]
    }]
    return row


def fail(message):
    print(f"omalaunch-github: {message}", file=sys.stderr)
    raise SystemExit(1)


def gh(endpoint, fields=None, method="GET"):
    command = ["gh", "api", "--method", method, endpoint]
    for key, value in (fields or {}).items():
        command += ["-f", f"{key}={value}"]
    try:
        result = subprocess.run(command, check=False, capture_output=True, text=True, timeout=TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(str(error))
    if result.returncode != 0:
        fail(result.stderr.strip() or f"gh exited with {result.returncode}")
    if not result.stdout.strip():
        return {}
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        fail(f"gh returned invalid JSON: {error}")


def api_path(url):
    parsed = urlparse(str(url or ""))
    if parsed.netloc and parsed.netloc not in ("api.github.com", "github.com"):
        fail("unsupported GitHub API host")
    return parsed.path.lstrip("/") if parsed.netloc else str(url or "").lstrip("/")


def list_date(value):
    if not value:
        return ""
    try:
        moment = datetime.fromisoformat(value.replace("Z", "+00:00"))
        now = datetime.now(timezone.utc)
        age = max(0, int((now - moment.astimezone(timezone.utc)).total_seconds()))
        if age < 60:
            return "now"
        if age < 3600:
            return f"{age // 60}m"
        if age < 86400:
            return f"{age // 3600}h"
        if age < 7 * 86400:
            return f"{age // 86400}d"
        if moment.year == now.year:
            return f"{moment.strftime('%b')} {moment.day}"
        return f"{moment.strftime('%b')} {moment.day}, {moment.year}"
    except ValueError:
        return ""


def compact(value, limit=512):
    return " ".join(str(value or "").split())[:limit]


def date(value):
    if not value:
        return ""
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d %H:%M")
    except ValueError:
        return compact(value, 64)


def action_open(url):
    return {"id": "open", "label": "Open on GitHub", "command": ["xdg-open", url], "closeOnSuccess": True}


def action_copy(url):
    return {"id": "copy-url", "label": "Copy URL", "command": ["wl-copy", "--", url]}


def status_presentation(status, conclusion=""):
    value = compact(conclusion or status, 64).lower()
    if value == "success":
        return "Success", "success", "✓"
    if value in ("failure", "timed_out", "startup_failure", "stale"):
        return "Failure", "danger", "✕"
    if value in ("queued", "in_progress", "pending", "requested", "waiting"):
        return "Pending", "warning", "●"
    if value == "cancelled":
        return "Cancelled", "neutral", "−"
    if value in ("skipped", "neutral"):
        return "Skipped", "neutral", "−"
    return "Unknown", "neutral", "?"


def repo_name_from_url(url):
    path = api_path(url).split("/")
    return "/".join(path[1:3]) if len(path) >= 3 and path[0] == "repos" else ""


def repo_row(repo):
    name = repo.get("full_name", "")
    return {
        "id": f"repo:{name}", "label": name, "icon": "󰊢",
        "trailingText": list_date(repo.get("updated_at")),
        "description": compact(repo.get("description") or "Repository"),
        "aliases": [repo.get("language") or "", "repository", "repo"],
        "context": {"repository": name},
        "submenu": {"command": [SELF, "repository", name]},
    }


def issue_row(item, kind=None):
    is_pr = bool(item.get("pull_request")) if kind is None else kind == "pr"
    repo = repo_name_from_url(item.get("repository_url")) or item.get("repository", {}).get("full_name", "")
    number = str(item.get("number", ""))
    label = compact(item.get("title"), 256)
    prefix = "pr" if is_pr else "issue"
    return {
        "id": f"{prefix}:{repo}#{number}", "label": label,
        "icon": "󰘬" if is_pr else "󰅚", "trailingText": list_date(item.get("updated_at")),
        "description": f"{repo} #{number} · {compact(item.get('user', {}).get('login'))}",
        "aliases": [repo, f"#{number}", "pull request" if is_pr else "issue"],
        "context": {"repository": repo, "number": number},
        "document": {"command": [SELF, f"{prefix}-document", repo, number]},
    }


def notification_row(item):
    subject = item.get("subject") or {}
    repo = (item.get("repository") or {}).get("full_name", "")
    thread = str(item.get("id", ""))
    return {
        "id": f"notification:{thread}", "label": compact(subject.get("title"), 256), "icon": "󰂚",
        "trailingText": list_date(item.get("updated_at")),
        "description": f"{repo} · {compact(item.get('reason'))} · {compact(subject.get('type'))}",
        "aliases": [repo, item.get("reason") or "", subject.get("type") or "", "notification"],
        "context": {"thread": thread},
        "document": {"command": [SELF, "notification-document", thread]},
    }


def repositories(limit=LIMIT):
    data = gh("user/repos", {"affiliation": "owner,collaborator,organization_member", "sort": "updated", "direction": "desc", "per_page": str(limit)})
    return [repo_row(item) for item in data if not item.get("archived")][:limit]


def search_rows(kind, limit=LIMIT, repository=""):
    qualifier = "is:pr" if kind == "pr" else "is:issue"
    query = f"{qualifier} is:open " + (f"repo:{repository}" if repository else "involves:@me archived:false")
    data = gh("search/issues", {"q": query, "sort": "updated", "order": "desc", "per_page": str(limit)})
    return [issue_row(item, kind) for item in data.get("items", [])][:limit]


def notifications(limit=LIMIT, repository=""):
    endpoint = f"repos/{repository}/notifications" if repository else "notifications"
    data = gh(endpoint, {"all": "false", "participating": "false", "per_page": str(limit)})
    return [notification_row(item) for item in data][:limit]


def action_runs(repository, limit=80):
    data = gh(f"repos/{repository}/actions/runs", {"per_page": str(min(limit, 100))})
    rows = []
    for run in data.get("workflow_runs", [])[:limit]:
        run_id = str(run.get("id", ""))
        label, tone, _ = status_presentation(run.get("status"), run.get("conclusion"))
        title = compact(run.get("name") or run.get("display_title") or f"Run {run_id}", 256)
        branch = compact(run.get("head_branch"), 128)
        event = compact(run.get("event"), 64).replace("_", " ")
        rows.append({
            "id": f"action-run:{run_id}", "label": title, "icon": "󰑮",
            "description": " · ".join(value for value in (branch, event) if value),
            "trailingText": list_date(run.get("updated_at") or run.get("created_at")),
            "badge": label, "badgeTone": tone,
            "document": {"command": [SELF, "action-run-document", repository, run_id]},
        })
    return rows


def category(identifier, label, command, icon=""):
    return {"id": identifier, "label": label, "icon": icon, "globalSearch": False,
            "submenu": {"command": [SELF] + command}}


def root_menu():
    definitions = [
        ("repositories", "Repositories", ["repositories"], "󰊢"),
        ("issues", "Issues", ["issues"], "󰅚"),
        ("pull-requests", "Pull Requests", ["pull-requests"], "󰘬"),
        ("notifications", "Notifications", ["notifications"], "󰂚"),
    ]
    return [starrable(category(identifier, label, command, icon), f"general:{identifier}",
                      f"GitHub · {label}") for identifier, label, command, icon in definitions]


def global_search_menu():
    with ThreadPoolExecutor(max_workers=4) as pool:
        jobs = [pool.submit(repositories), pool.submit(search_rows, "issue"),
                pool.submit(search_rows, "pr"), pool.submit(notifications)]
        groups = [job.result() for job in jobs]
    rows = starred_shortcuts()
    for group in groups:
        rows.extend(group)
    return rows[:100]


def repository_counts(name):
    def search_count(kind):
        data = gh("search/issues", {
            "q": f"is:{kind} is:open repo:{name}", "per_page": "1"
        })
        return int(data.get("total_count", len(data.get("items", []))))

    with ThreadPoolExecutor(max_workers=3) as pool:
        issue_job = pool.submit(search_count, "issue")
        pull_job = pool.submit(search_count, "pr")
        notification_job = pool.submit(gh, f"repos/{name}/notifications", {
            "all": "false", "participating": "false", "per_page": "100"
        })
        return issue_job.result(), pull_job.result(), len(notification_job.result())


def repository_shortcut(name, section):
    definitions = {
        "overview": ("Overview", "󰋜", {"document": {"command": [SELF, "repo-document", name]}}),
        "issues": ("Issues", "󰅚", {"submenu": {"command": [SELF, "repo-issues", name]}}),
        "pull-requests": ("Pull Requests", "󰘬", {"submenu": {"command": [SELF, "repo-pull-requests", name]}}),
        "notifications": ("Notifications", "󰂚", {"submenu": {"command": [SELF, "repo-notifications", name]}}),
        "actions": ("Actions", "󰑮", {"submenu": {"command": [SELF, "repo-actions", name]}}),
    }
    label, icon, behavior = definitions[section]
    row = {"id": section, "label": label, "icon": icon, "globalSearch": False}
    row.update(behavior)
    return starrable(row, f"repo:{name}:{section}", f"{name} · {label}")


def starred_shortcuts():
    rows = []
    for row in root_menu():
        if row["starred"]:
            row["globalSearch"] = True
            rows.append(row)
    for key in sorted(load_stars()):
        if not key.startswith("repo:"):
            continue
        repository, section = key[5:].rsplit(":", 1)
        row = repository_shortcut(repository, section)
        row["globalSearch"] = True
        rows.append(row)
    return rows


def repository_menu(name):
    url = f"https://github.com/{name}"
    issue_count, pull_count, notification_count = repository_counts(name)
    overview = repository_shortcut(name, "overview")
    issues = repository_shortcut(name, "issues")
    issues["badge"] = str(issue_count)
    pulls = repository_shortcut(name, "pull-requests")
    pulls["badge"] = str(pull_count)
    repo_notifications = repository_shortcut(name, "notifications")
    repo_notifications["badge"] = "100+" if notification_count >= 100 else str(notification_count)
    actions = repository_shortcut(name, "actions")
    return [
        overview, issues, pulls, repo_notifications, actions,
        {"id": "open", "label": "Open on GitHub", "icon": "󰖟", "command": ["xdg-open", url], "closeOnSuccess": True},
        {"id": "copy-url", "label": "Copy URL", "icon": "󰆏", "command": ["wl-copy", "--", url]},
    ]


def emit(value):
    json.dump(value, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")


def repo_document(name):
    item = gh(f"repos/{name}")
    url = item.get("html_url") or f"https://github.com/{name}"
    topics = [compact(topic, 64) for topic in item.get("topics", []) if compact(topic, 64)]
    sections = [{"heading": "Topics", "text": "  ·  ".join(topics)}] if topics else []
    emit({
        "title": item.get("full_name") or name, "subtitle": compact(item.get("description")),
        "icon": "󰊢",
        "status": "Archived" if item.get("archived") else ("Private" if item.get("private") else "Public"),
        "stats": [
            {"label": "Stars", "value": str(item.get("stargazers_count", 0)), "icon": "󰓎"},
            {"label": "Forks", "value": str(item.get("forks_count", 0)), "icon": "󰘬"},
            {"label": "Open issues", "value": str(item.get("open_issues_count", 0)), "icon": "󰅚"},
        ],
        "fields": [
            {"label": "Owner", "value": compact(item.get("owner", {}).get("login"))},
            {"label": "Language", "value": compact(item.get("language")) or "—"},
            {"label": "Default branch", "value": compact(item.get("default_branch"))},
            {"label": "Updated", "value": date(item.get("updated_at"))},
        ],
        "sections": sections, "actions": [action_open(url), action_copy(url)],
    })


def issue_document(repo, number):
    item = gh(f"repos/{repo}/issues/{number}")
    url = item.get("html_url", "")
    labels = ", ".join(label.get("name", "") for label in item.get("labels", [])) or "—"
    assignees = ", ".join(user.get("login", "") for user in item.get("assignees", [])) or "—"
    emit({
        "title": item.get("title") or f"Issue #{number}", "subtitle": f"{repo} #{number}", "icon": "󰅚",
        "status": compact(item.get("state"), 64).title(),
        "fields": [
            {"label": "Author", "value": compact(item.get("user", {}).get("login"))},
            {"label": "Assignees", "value": assignees}, {"label": "Labels", "value": labels},
            {"label": "Comments", "value": str(item.get("comments", 0))},
            {"label": "Created", "value": date(item.get("created_at"))},
            {"label": "Updated", "value": date(item.get("updated_at"))},
        ],
        "sections": [{"heading": "Description", "text": (item.get("body") or "No description.")[:32768], "format": "markdown"}],
        "actions": [action_open(url), action_copy(url)],
    })


def combined_status(value):
    if isinstance(value, dict):
        return compact(value.get("state"), 64).title() or "Unknown"
    if not isinstance(value, list) or not value:
        return "Unknown"
    states = [compact(item.get("state"), 64).lower() for item in value if isinstance(item, dict)]
    if any(state in ("failure", "error") for state in states):
        return "Failure"
    if any(state in ("pending", "queued", "in_progress") for state in states):
        return "Pending"
    if states and all(state == "success" for state in states):
        return "Success"
    return "Unknown"


def pr_document(repo, number):
    item = gh(f"repos/{repo}/pulls/{number}")
    statuses = []
    check_runs = []
    if item.get("statuses_url"):
        try:
            statuses = gh(api_path(item["statuses_url"]))
        except SystemExit:
            statuses = []
    head_sha = item.get("head", {}).get("sha")
    if head_sha:
        try:
            check_runs = gh(f"repos/{repo}/commits/{head_sha}/check-runs", {"per_page": "100"}).get("check_runs", [])
        except SystemExit:
            check_runs = []
    presentations = [status_presentation(run.get("status"), run.get("conclusion")) for run in check_runs]
    passed = sum(label == "Success" for label, _, _ in presentations)
    failed = sum(label == "Failure" for label, _, _ in presentations)
    pending = sum(label == "Pending" for label, _, _ in presentations)
    check_summary = " · ".join(part for part in (
        f"{passed} passed" if passed else "", f"{failed} failed" if failed else "",
        f"{pending} pending" if pending else "") if part) or combined_status(statuses)
    check_lines = []
    for run, presentation in zip(check_runs, presentations):
        label, _, marker = presentation
        check_lines.append(f"- {marker} {compact(run.get('name') or 'Check', 180)} — {label}")
    url = item.get("html_url", "")
    reviewers = ", ".join(user.get("login", "") for user in item.get("requested_reviewers", [])) or "—"
    state = "Draft" if item.get("draft") else ("Merged" if item.get("merged") else compact(item.get("state")).title())
    sections = []
    if check_lines:
        sections.append({"heading": "Checks", "text": "\n".join(check_lines), "format": "markdown"})
    sections.append({"heading": "Description", "text": (item.get("body") or "No description.")[:32768], "format": "markdown"})
    emit({
        "title": item.get("title") or f"Pull request #{number}", "subtitle": f"{repo} #{number}", "icon": "󰘬", "status": state,
        "fields": [
            {"label": "Author", "value": compact(item.get("user", {}).get("login"))},
            {"label": "Reviewers", "value": reviewers},
            {"label": "Checks", "value": check_summary},
            {"label": "Branches", "value": f"{compact(item.get('head', {}).get('ref'))} → {compact(item.get('base', {}).get('ref'))}"},
            {"label": "Changes", "value": f"+{item.get('additions', 0)} −{item.get('deletions', 0)} in {item.get('changed_files', 0)} files"},
            {"label": "Mergeable", "value": str(item.get("mergeable", "unknown")).title()},
            {"label": "Created", "value": date(item.get("created_at"))},
            {"label": "Updated", "value": date(item.get("updated_at"))},
        ],
        "sections": sections,
        "actions": [action_open(url), action_copy(url)],
    })


def notification_document(thread):
    item = gh(f"notifications/threads/{thread}")
    subject = item.get("subject") or {}
    related = {}
    if subject.get("url"):
        related = gh(api_path(subject["url"]))
    repo = (item.get("repository") or {}).get("full_name", "")
    url = related.get("html_url") or (item.get("repository") or {}).get("html_url") or f"https://github.com/{repo}"
    actions = [action_open(url), action_copy(url), {
        "id": "mark-read", "label": "Mark as read", "command": [SELF, "mark-read", thread]
    }]
    emit({
        "title": subject.get("title") or "GitHub notification", "subtitle": repo, "icon": "󰂚",
        "status": "Unread" if item.get("unread", True) else "Read",
        "fields": [
            {"label": "Reason", "value": compact(item.get("reason")).replace("_", " ").title()},
            {"label": "Type", "value": compact(subject.get("type"))},
            {"label": "Author", "value": compact(related.get("user", {}).get("login")) or "—"},
            {"label": "Updated", "value": date(item.get("updated_at"))},
        ],
        "sections": [{"heading": "Description", "text": (related.get("body") or "No description is available.")[:32768], "format": "markdown"}],
        "actions": actions,
    })


def action_run_document(repo, run_id):
    run = gh(f"repos/{repo}/actions/runs/{run_id}")
    jobs = gh(f"repos/{repo}/actions/runs/{run_id}/jobs", {"per_page": "100"}).get("jobs", [])
    label, _, _ = status_presentation(run.get("status"), run.get("conclusion"))
    job_lines = []
    for job in jobs:
        job_label, _, marker = status_presentation(job.get("status"), job.get("conclusion"))
        duration = ""
        if job.get("started_at") and job.get("completed_at"):
            try:
                started = datetime.fromisoformat(job["started_at"].replace("Z", "+00:00"))
                completed = datetime.fromisoformat(job["completed_at"].replace("Z", "+00:00"))
                duration = f" · {max(0, int((completed - started).total_seconds()))}s"
            except ValueError:
                duration = ""
        job_lines.append(f"- {marker} {compact(job.get('name') or 'Job', 180)} — {job_label}{duration}")
    url = run.get("html_url") or f"https://github.com/{repo}/actions/runs/{run_id}"
    actor = run.get("actor") or run.get("triggering_actor") or {}
    emit({
        "title": run.get("name") or run.get("display_title") or f"Workflow run {run_id}",
        "subtitle": f"{repo} · Run #{run.get('run_number', run_id)}", "icon": "󰑮", "status": label,
        "fields": [
            {"label": "Branch", "value": compact(run.get("head_branch")) or "—"},
            {"label": "Commit", "value": compact(run.get("head_sha"), 12) or "—"},
            {"label": "Event", "value": compact(run.get("event")).replace("_", " ") or "—"},
            {"label": "Actor", "value": compact(actor.get("login")) or "—"},
            {"label": "Created", "value": date(run.get("created_at"))},
            {"label": "Updated", "value": date(run.get("updated_at"))},
        ],
        "sections": [{"heading": "Jobs", "text": "\n".join(job_lines) if job_lines else "No jobs are available.",
                      "format": "markdown"}],
        "actions": [action_open(url), action_copy(url)],
    })


def main():
    args = sys.argv[1:]
    command = args[0] if args else "menu"
    if command in ("menu", "root"): emit(root_menu())
    elif command == "global-search": emit(global_search_menu())
    elif command == "repositories": emit(repositories(80))
    elif command == "issues": emit(search_rows("issue", 80))
    elif command == "pull-requests": emit(search_rows("pr", 80))
    elif command == "notifications": emit(notifications(80))
    elif command == "repository" and len(args) == 2: emit(repository_menu(args[1]))
    elif command == "repo-issues" and len(args) == 2: emit(search_rows("issue", 80, args[1]))
    elif command == "repo-pull-requests" and len(args) == 2: emit(search_rows("pr", 80, args[1]))
    elif command == "repo-notifications" and len(args) == 2: emit(notifications(80, args[1]))
    elif command == "repo-actions" and len(args) == 2: emit(action_runs(args[1], 80))
    elif command == "action-run-document" and len(args) == 3: action_run_document(args[1], args[2])
    elif command == "repo-document" and len(args) == 2: repo_document(args[1])
    elif command == "issue-document" and len(args) == 3: issue_document(args[1], args[2])
    elif command == "pr-document" and len(args) == 3: pr_document(args[1], args[2])
    elif command == "notification-document" and len(args) == 2: notification_document(args[1])
    elif command == "mark-read" and len(args) == 2: gh(f"notifications/threads/{args[1]}", method="PATCH")
    elif command == "set-star" and len(args) == 3: set_star(args[1], args[2])
    else: fail("invalid command")


if __name__ == "__main__":
    main()
