#!/usr/bin/env python3
"""Read GitHub state through gh and emit bounded Omalaunch menu documents."""

import fcntl
import hashlib
import json
import os
import re
import subprocess
import time
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from urllib.parse import urlparse

LIMIT = 24
TIMEOUT = 4
SELF = os.path.realpath(__file__)
STATE_PATH = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                          "omarchy", "omalaunch", "extensions", "quantumfire.github.json")
CONFIG_PATH = os.path.join(os.path.expanduser("~/.config"), "omarchy", "omalaunch", "extensions",
                           "quantumfire.github.jsonc")
CACHE_DIR = os.path.join(os.path.dirname(STATE_PATH), "quantumfire.github-cache")
STAR_KEY = re.compile(r"^(?:general:(?:repositories|issues|pull-requests|notifications)|repository:[^:]+/[^:]+|repo:[^:]+/[^:]+:(?:overview|issues|pull-requests|notifications|actions))$")
CONFIG_ERROR = ""


def strip_jsonc(raw):
    text = raw.decode("utf-8")
    output = []
    index = 0
    in_string = escaped = False
    while index < len(text):
        character = text[index]
        if in_string:
            output.append(character)
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == '"':
                in_string = False
            index += 1
        elif character == '"':
            in_string = True
            output.append(character)
            index += 1
        elif text.startswith("//", index):
            end = text.find("\n", index + 2)
            index = len(text) if end < 0 else end
        elif text.startswith("/*", index):
            end = text.find("*/", index + 2)
            if end < 0:
                raise ValueError("unterminated block comment")
            output.extend("\n" for value in text[index:end + 2] if value == "\n")
            index = end + 2
        else:
            output.append(character)
            index += 1
    text = "".join(output)
    output = []
    index = 0
    in_string = escaped = False
    while index < len(text):
        character = text[index]
        if in_string:
            output.append(character)
            if escaped: escaped = False
            elif character == "\\": escaped = True
            elif character == '"': in_string = False
        elif character == '"':
            in_string = True
            output.append(character)
        elif character == ",":
            following = index + 1
            while following < len(text) and text[following].isspace(): following += 1
            if following >= len(text) or text[following] not in "]}": output.append(character)
        else:
            output.append(character)
        index += 1
    return "".join(output)


def config_defaults():
    return {
        "actionsTopLevel": {"enabled": False, "repositories": [],
                            "statuses": ["queued", "in_progress", "success", "failure"],
                            "completedWithinMinutes": 30, "limit": 5},
        "repositories": {"enabled": False, "scope": "owned", "limit": 10, "overrides": {}},
        "issues": {"enabled": False, "limit": 10, "overrides": {}},
        "pullRequests": {"enabled": False, "limit": 10, "overrides": {}},
        "notifications": {"enabled": False, "limit": 10},
        "excludedRepositories": [],
    }


def validate_overrides(value, item_pattern):
    if not isinstance(value, dict) or len(value) > 256:
        raise ValueError("invalid overrides")
    if any(not isinstance(key, str) or not item_pattern.fullmatch(key) or not isinstance(enabled, bool)
           for key, enabled in value.items()):
        raise ValueError("invalid override entry")
    return dict(value)


def load_config():
    global CONFIG_ERROR
    CONFIG_ERROR = ""
    defaults = config_defaults()
    try:
        if not os.path.exists(CONFIG_PATH):
            return defaults
        if os.path.getsize(CONFIG_PATH) > 64 * 1024:
            raise ValueError("file exceeds 64 KiB")
        with open(CONFIG_PATH, "rb") as config_file:
            value = json.loads(strip_jsonc(config_file.read()))
        stack = [(value, 1)]
        while stack:
            current, level = stack.pop()
            if level > 8: raise ValueError("nesting exceeds 8 levels")
            if isinstance(current, dict): children = current.values()
            elif isinstance(current, list): children = current
            else: continue
            stack.extend((child, level + 1) for child in children if isinstance(child, (dict, list)))
        if not isinstance(value, dict) or value.get("version") != 1:
            raise ValueError("invalid version")
        allowed_root = {"version", "repositories", "issues", "pullRequests", "notifications", "globalSearch", "actions"}
        if set(value) - allowed_root:
            raise ValueError("unknown root field")
        item_patterns = {
            "repositories": re.compile(r"^[^/#:]+/[^/#:]+$"),
            "issues": re.compile(r"^[^/#:]+/[^/#:]+#[1-9][0-9]*$"),
            "pullRequests": re.compile(r"^[^/#:]+/[^/#:]+#[1-9][0-9]*$"),
        }
        for entity in ("repositories", "issues", "pullRequests", "notifications"):
            raw_entity = value.get(entity, {})
            if not isinstance(raw_entity, dict) or set(raw_entity) - {"globalSearch"}:
                raise ValueError(f"invalid {entity} settings")
            raw_search = raw_entity.get("globalSearch", {})
            allowed = {"enabled", "limit"}
            if entity == "repositories":
                allowed |= {"scope", "overrides"}
            elif entity != "notifications":
                allowed.add("overrides")
            if not isinstance(raw_search, dict) or set(raw_search) - allowed:
                raise ValueError(f"invalid {entity} global search settings")
            target = defaults[entity]
            if "enabled" in raw_search:
                if not isinstance(raw_search["enabled"], bool): raise ValueError("enabled must be boolean")
                target["enabled"] = raw_search["enabled"]
            if "limit" in raw_search:
                limit = raw_search["limit"]
                if isinstance(limit, bool) or not isinstance(limit, int) or not 1 <= limit <= 100:
                    raise ValueError("limit must be from 1 to 100")
                target["limit"] = limit
            if entity == "repositories" and "scope" in raw_search:
                if raw_search["scope"] not in ("owned", "visible"):
                    raise ValueError("invalid repository scope")
                target["scope"] = raw_search["scope"]
            if entity != "notifications" and "overrides" in raw_search:
                target["overrides"] = validate_overrides(raw_search["overrides"], item_patterns[entity])
        actions = value.get("actions", {})
        if not isinstance(actions, dict) or set(actions) - {"topLevel"}:
            raise ValueError("invalid actions settings")
        top_level = actions.get("topLevel", {})
        allowed_top_level = {"enabled", "repositories", "statuses", "completedWithinMinutes", "limit"}
        if not isinstance(top_level, dict) or set(top_level) - allowed_top_level:
            raise ValueError("invalid actions.topLevel settings")
        target = defaults["actionsTopLevel"]
        if "enabled" in top_level:
            if not isinstance(top_level["enabled"], bool): raise ValueError("actions.topLevel.enabled must be boolean")
            target["enabled"] = top_level["enabled"]
        if "repositories" in top_level:
            repositories = top_level["repositories"]
            if (not isinstance(repositories, list) or len(repositories) > 16
                    or len(set(repositories)) != len(repositories)
                    or any(not isinstance(repo, str) or not item_patterns["repositories"].fullmatch(repo) for repo in repositories)):
                raise ValueError("invalid actions.topLevel.repositories")
            target["repositories"] = list(repositories)
        if "statuses" in top_level:
            statuses = top_level["statuses"]
            allowed_statuses = {"queued", "in_progress", "success", "failure"}
            if (not isinstance(statuses, list) or not statuses or len(statuses) > 4
                    or len(set(statuses)) != len(statuses) or any(status not in allowed_statuses for status in statuses)):
                raise ValueError("invalid actions.topLevel.statuses")
            target["statuses"] = list(statuses)
        for field, minimum, maximum in (("completedWithinMinutes", 1, 1440), ("limit", 1, 20)):
            if field in top_level:
                number = top_level[field]
                if isinstance(number, bool) or not isinstance(number, int) or not minimum <= number <= maximum:
                    raise ValueError(f"actions.topLevel.{field} must be from {minimum} to {maximum}")
                target[field] = number

        global_search = value.get("globalSearch", {})
        if not isinstance(global_search, dict) or set(global_search) - {"excludedRepositories"}:
            raise ValueError("invalid globalSearch settings")
        excluded = global_search.get("excludedRepositories", [])
        if (not isinstance(excluded, list) or len(excluded) > 256 or len(set(excluded)) != len(excluded)
                or any(not isinstance(item, str) or not item_patterns["repositories"].fullmatch(item) for item in excluded)):
            raise ValueError("invalid excludedRepositories")
        defaults["excludedRepositories"] = excluded
        return defaults
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        CONFIG_ERROR = compact(str(error), 240)
        print(f"omalaunch-github: ignored invalid configuration: {CONFIG_ERROR}", file=sys.stderr)
        return defaults


def cache_read(key, ttl, allow_expired=False):
    path = os.path.join(CACHE_DIR, hashlib.sha256(key.encode()).hexdigest() + ".json")
    try:
        if not allow_expired and time.time() - os.path.getmtime(path) > ttl:
            return None
        if os.path.getsize(path) > 1024 * 1024:
            return None
        with open(path, encoding="utf-8") as cache_file:
            return json.load(cache_file)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None


def cache_write(key, value):
    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(CACHE_DIR, hashlib.sha256(key.encode()).hexdigest() + ".json")
    temporary = path + f".tmp.{os.getpid()}"
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as cache_file:
            json.dump(value, cache_file, separators=(",", ":"))
            cache_file.flush()
            os.fsync(cache_file.fileno())
        os.replace(temporary, path)
        directory = os.open(CACHE_DIR, os.O_RDONLY)
        try: os.fsync(directory)
        finally: os.close(directory)
        return value
    finally:
        try: os.unlink(temporary)
        except FileNotFoundError: pass


def cached_gh(key, ttl, endpoint, fields=None, force=False, stale_ttl=None):
    if not force:
        cached = cache_read(key, ttl)
        if cached is not None:
            return cached
    try:
        return cache_write(key, gh(endpoint, fields))
    except SystemExit:
        stale = None if force else cache_read(key, stale_ttl or ttl, allow_expired=stale_ttl is None)
        if stale is not None:
            return stale
        raise


def cached_value(key, ttl, force, producer):
    if not force:
        cached = cache_read(key, ttl)
        if cached is not None:
            return cached
    try:
        return cache_write(key, producer())
    except SystemExit:
        stale = None if force else cache_read(key, ttl, allow_expired=True)
        if stale is not None:
            return stale
        raise


def clear_cache():
    try:
        for name in os.listdir(CACHE_DIR):
            if name.endswith(".json"):
                os.unlink(os.path.join(CACHE_DIR, name))
    except OSError:
        pass


def read_stars(strict=False):
    try:
        if not os.path.exists(STATE_PATH):
            return set()
        if os.path.getsize(STATE_PATH) > 64 * 1024:
            raise ValueError("state exceeds 64 KiB")
        with open(STATE_PATH, encoding="utf-8") as state_file:
            value = json.load(state_file)
        if not isinstance(value, dict) or set(value) != {"version", "stars"} or value.get("version") != 1:
            raise ValueError("invalid star state")
        stars = value.get("stars")
        if (not isinstance(stars, list) or len(stars) > 256
                or any(not isinstance(item, str) or not STAR_KEY.fullmatch(item) for item in stars)
                or len(set(stars)) != len(stars)):
            raise ValueError("invalid stars")
        return set(stars)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        if strict: fail(f"refusing to overwrite invalid star state: {error}")
        return set()


def load_stars():
    return read_stars(False)


def save_stars(stars):
    directory_path = os.path.dirname(STATE_PATH)
    os.makedirs(directory_path, mode=0o700, exist_ok=True)
    temporary = STATE_PATH + f".tmp.{os.getpid()}"
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as state_file:
            json.dump({"version": 1, "stars": sorted(stars)}, state_file, separators=(",", ":"))
            state_file.write("\n")
            state_file.flush()
            os.fsync(state_file.fileno())
        os.replace(temporary, STATE_PATH)
        directory = os.open(directory_path, os.O_RDONLY)
        try: os.fsync(directory)
        finally: os.close(directory)
    finally:
        try: os.unlink(temporary)
        except FileNotFoundError: pass


def set_star(key, enabled):
    if not STAR_KEY.fullmatch(key) or enabled not in ("true", "false"):
        fail("invalid star request")
    directory = os.path.dirname(STATE_PATH)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    lock_path = STATE_PATH + ".lock"
    with open(lock_path, "a", encoding="utf-8") as lock_file:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        stars = read_stars(True)
        if enabled == "true": stars.add(key)
        else: stars.discard(key)
        save_stars(stars)


def starrable(row, key, starred_label):
    starred = key in load_stars()
    row = dict(row)
    row["id"] = key
    row["starred"] = starred
    row["starredLabel"] = starred_label
    row["starAction"] = "star"
    row["actions"] = list(row.get("actions", [])) + [{
        "id": "star", "label": "Remove from top level" if starred else "Add to top level",
        "command": [SELF, "set-star", key, "false" if starred else "true"]
    }]
    return row


def fail(message):
    print(f"omalaunch-github: {message}", file=sys.stderr)
    raise SystemExit(1)


def gh(endpoint, fields=None, method="GET"):
    command = ["gh", "api", "--method", method, endpoint]
    for key, value in (fields or {}).items():
        command += ["-f", f"{key}={value}"]
    try:
        result = subprocess.run(command, check=False, capture_output=True, text=True, timeout=TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(str(error))
    if result.returncode != 0:
        fail(result.stderr.strip() or f"gh exited with {result.returncode}")
    if not result.stdout.strip():
        return {}
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        fail(f"gh returned invalid JSON: {error}")


def api_path(url):
    parsed = urlparse(str(url or ""))
    if parsed.netloc and parsed.netloc not in ("api.github.com", "github.com"):
        fail("unsupported GitHub API host")
    return parsed.path.lstrip("/") if parsed.netloc else str(url or "").lstrip("/")


def list_date(value):
    if not value:
        return ""
    try:
        moment = datetime.fromisoformat(value.replace("Z", "+00:00"))
        now = datetime.now(timezone.utc)
        age = max(0, int((now - moment.astimezone(timezone.utc)).total_seconds()))
        if age < 60:
            return "now"
        if age < 3600:
            return f"{age // 60}m"
        if age < 86400:
            return f"{age // 3600}h"
        if age < 7 * 86400:
            return f"{age // 86400}d"
        if moment.year == now.year:
            return f"{moment.strftime('%b')} {moment.day}"
        return f"{moment.strftime('%b')} {moment.day}, {moment.year}"
    except ValueError:
        return ""


def compact(value, limit=512):
    return " ".join(str(value or "").split())[:limit]


def date(value):
    if not value:
        return ""
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d %H:%M")
    except ValueError:
        return compact(value, 64)


def action_open(url):
    return {"id": "open", "label": "Open on GitHub", "command": ["xdg-open", url], "closeOnSuccess": True}


def action_copy(url):
    return {"id": "copy-url", "label": "Copy URL", "command": ["wl-copy", "--", url]}


def status_presentation(status, conclusion=""):
    value = compact(conclusion or status, 64).lower()
    if value == "success":
        return "Success", "success", "✓"
    if value in ("failure", "timed_out", "startup_failure", "stale"):
        return "Failure", "danger", "✕"
    if value in ("queued", "in_progress", "pending", "requested", "waiting"):
        return "Pending", "warning", "●"
    if value == "cancelled":
        return "Cancelled", "neutral", "−"
    if value in ("skipped", "neutral"):
        return "Skipped", "neutral", "−"
    return "Unknown", "neutral", "?"


def repo_name_from_url(url):
    path = api_path(url).split("/")
    return "/".join(path[1:3]) if len(path) >= 3 and path[0] == "repos" else ""


def repo_row(repo):
    name = repo.get("full_name", "")
    row = {
        "id": f"repo:{name}", "label": name, "icon": "󰊢",
        "trailingText": list_date(repo.get("updated_at")),
        "description": compact(repo.get("description") or "Repository"),
        "aliases": [repo.get("language") or "", "repository", "repo"],
        "context": {"repository": name},
        "submenu": {"command": [SELF, "repository", name],
                    "refreshCommand": [SELF, "repository", name, "--refresh"]},
    }
    return starrable(row, f"repository:{name}", name)


def issue_row(item, kind=None):
    is_pr = bool(item.get("pull_request")) if kind is None else kind == "pr"
    repo = repo_name_from_url(item.get("repository_url")) or item.get("repository", {}).get("full_name", "")
    number = str(item.get("number", ""))
    label = compact(item.get("title"), 256)
    prefix = "pr" if is_pr else "issue"
    return {
        "id": f"{prefix}:{repo}#{number}", "label": label,
        "icon": "󰘬" if is_pr else "󰅚", "trailingText": list_date(item.get("updated_at")),
        "description": f"{repo} #{number} · {compact(item.get('user', {}).get('login'))}",
        "aliases": [repo, f"#{number}", "pull request" if is_pr else "issue"],
        "context": {"repository": repo, "number": number},
        "document": {"command": [SELF, f"{prefix}-document", repo, number],
                     "refreshCommand": [SELF, f"{prefix}-document", repo, number, "--refresh"]},
    }


def notification_row(item):
    subject = item.get("subject") or {}
    repo = (item.get("repository") or {}).get("full_name", "")
    thread = str(item.get("id", ""))
    return {
        "id": f"notification:{thread}", "label": compact(subject.get("title"), 256), "icon": "󰂚",
        "trailingText": list_date(item.get("updated_at")),
        "description": f"{repo} · {compact(item.get('reason'))} · {compact(subject.get('type'))}",
        "aliases": [repo, item.get("reason") or "", subject.get("type") or "", "notification"],
        "context": {"thread": thread},
        "document": {"command": [SELF, "notification-document", thread],
                     "refreshCommand": [SELF, "notification-document", thread, "--refresh"]},
    }


def repository_data(force=False):
    return cached_gh("repositories", 60, "user/repos", {
        "affiliation": "owner,collaborator,organization_member", "sort": "updated",
        "direction": "desc", "per_page": "100"
    }, force)


def repositories(limit=LIMIT, force=False):
    return [repo_row(item) for item in repository_data(force) if not item.get("archived")][:limit]


def search_data(kind, repository="", force=False):
    qualifier = "is:pr" if kind == "pr" else "is:issue"
    query = f"{qualifier} is:open " + (f"repo:{repository}" if repository else "involves:@me archived:false")
    return cached_gh(f"search:{kind}:{repository or '@me'}", 60, "search/issues", {
        "q": query, "sort": "updated", "order": "desc", "per_page": "100"
    }, force)


def search_rows(kind, limit=LIMIT, repository="", force=False):
    return [issue_row(item, kind) for item in search_data(kind, repository, force).get("items", [])][:limit]


def notification_data(repository="", force=False):
    endpoint = f"repos/{repository}/notifications" if repository else "notifications"
    return cached_gh(f"notifications:{repository or '@me'}", 60, endpoint, {
        "all": "false", "participating": "false", "per_page": "100"
    }, force)


def notifications(limit=LIMIT, repository="", force=False):
    return [notification_row(item) for item in notification_data(repository, force)][:limit]


def action_runs(repository, limit=30, force=False):
    data = cached_gh(f"actions:{repository}", 60, f"repos/{repository}/actions/runs",
                     {"per_page": "30"}, force)
    rows = []
    for run in data.get("workflow_runs", [])[:limit]:
        run_id = str(run.get("id", ""))
        label, tone, _ = status_presentation(run.get("status"), run.get("conclusion"))
        title = compact(run.get("name") or run.get("display_title") or f"Run {run_id}", 256)
        branch = compact(run.get("head_branch"), 128)
        event = compact(run.get("event"), 64).replace("_", " ")
        rows.append({
            "id": f"action-run:{repository}:{run_id}", "label": title, "icon": "󰑮",
            "description": " · ".join(value for value in (branch, event) if value),
            "trailingText": list_date(run.get("updated_at") or run.get("created_at")),
            "badge": label, "badgeTone": tone,
            "document": {"command": [SELF, "action-run-document", repository, run_id],
                         "refreshCommand": [SELF, "action-run-document", repository, run_id, "--refresh"]},
        })
    return rows


def parse_timestamp(value):
    try:
        return datetime.fromisoformat(str(value or "").replace("Z", "+00:00")).astimezone(timezone.utc)
    except ValueError:
        return None


def action_runs_row(repository, run):
    run_id = str(run.get("id", ""))
    label, tone, _ = status_presentation(run.get("status"), run.get("conclusion"))
    title = compact(run.get("name") or run.get("display_title") or f"Run {run_id}", 256)
    branch = compact(run.get("head_branch"), 128)
    event = compact(run.get("event"), 64).replace("_", " ")
    return {
        "id": f"action-run:{repository}:{run_id}", "label": f"{repository} · {title}", "icon": "󰑮",
        "description": " · ".join(value for value in (branch, event) if value),
        "trailingText": list_date(run.get("completed_at") or run.get("updated_at") or run.get("created_at")),
        "badge": label, "badgeTone": tone,
        "document": {"command": [SELF, "action-run-document", repository, run_id],
                     "refreshCommand": [SELF, "action-run-document", repository, run_id, "--refresh"]},
    }


def top_level_action_runs(force=False):
    settings = load_config()["actionsTopLevel"]
    if not settings["enabled"] or not settings["repositories"]:
        return []
    now = datetime.now(timezone.utc)
    statuses = set(settings["statuses"])
    candidates = []

    def load(repository):
        return repository, cached_gh(f"actions:{repository}", 60,
            f"repos/{repository}/actions/runs", {"per_page": "30"}, force, 120)

    with ThreadPoolExecutor(max_workers=min(4, len(settings["repositories"]))) as pool:
        results = list(pool.map(load, settings["repositories"]))
    seen = set()
    for repository, data in results:
        for run in data.get("workflow_runs", [])[:30]:
            run_id = str(run.get("id", ""))
            identity = f"{repository}:{run_id}"
            if not run_id or identity in seen:
                continue
            status = compact(run.get("status"), 32).lower()
            conclusion = compact(run.get("conclusion"), 32).lower()
            active = status in ("queued", "in_progress")
            selected_status = status if active else conclusion
            if selected_status not in statuses:
                continue
            completed = parse_timestamp(run.get("completed_at") or run.get("updated_at"))
            if not active and (not completed or (now - completed).total_seconds() > settings["completedWithinMinutes"] * 60):
                continue
            seen.add(identity)
            row = action_runs_row(repository, run)
            row["topLevel"] = True
            row["globalSearch"] = False
            candidates.append((0 if active else 1, 0 if conclusion == "failure" else 1,
                               -(completed or now).timestamp(), repository, run_id, row))
    candidates.sort(key=lambda item: item[:-1])
    return [item[-1] for item in candidates[:settings["limit"]]]


def preload_menu(force=False):
    return {"items": [], "globalSearchItems": global_search_menu(),
            "topLevelItems": top_level_action_runs(force)}


def category(identifier, label, command, icon=""):
    provider_command = [SELF] + command
    return {"id": identifier, "label": label, "icon": icon, "globalSearch": False,
            "submenu": {"command": provider_command,
                        "refreshCommand": provider_command + ["--refresh"]}}


def root_menu():
    definitions = [
        ("repositories", "Repositories", ["repositories"], "󰊢"),
        ("issues", "Issues", ["issues"], "󰅚"),
        ("pull-requests", "Pull Requests", ["pull-requests"], "󰘬"),
        ("notifications", "Notifications", ["notifications"], "󰂚"),
    ]
    rows = [starrable(category(identifier, label, command, icon), f"general:{identifier}",
                      f"GitHub · {label}") for identifier, label, command, icon in definitions]
    rows.append(category("configuration", "Configuration", ["configuration"], "󰒓"))
    return rows


def config_example_path():
    return os.path.abspath(os.path.join(os.path.dirname(SELF), "..", "config.example.jsonc"))


def ensure_config_file():
    if os.path.exists(CONFIG_PATH):
        return
    os.makedirs(os.path.dirname(CONFIG_PATH), mode=0o700, exist_ok=True)
    with open(config_example_path(), "rb") as source:
        content = source.read()
    try:
        descriptor = os.open(CONFIG_PATH, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return
    with os.fdopen(descriptor, "wb") as target:
        target.write(content)
        target.flush()
        os.fsync(target.fileno())


def open_config_with_editor():
    ensure_config_file()
    os.execvp("omarchy-launch-editor", ["omarchy-launch-editor", CONFIG_PATH])


def edit_config_with_agent():
    ensure_config_file()
    prompt = (
        f"Help the user edit the Omalaunch GitHub plugin configuration at {CONFIG_PATH}. "
        f"Use {config_example_path()} as the schema example. Start by giving the user a concise summary "
        "of the settings they can change, then ask what they want to change. Do not change the configuration "
        "until the user provides follow-up instructions. After that, preserve JSONC syntax, use version 1, "
        "and change only the requested settings."
    )
    os.execvp("omarchy-agent", ["omarchy-agent", "--prompt", prompt])


def configuration_menu():
    load_config()
    rows = []
    if CONFIG_ERROR:
        rows.append({"id": "invalid-config", "label": "Invalid configuration", "icon": "󰀪",
                     "description": CONFIG_ERROR, "badge": "Error", "badgeTone": "danger",
                     "command": [SELF, "open-config"], "closeOnDispatch": True})
    rows.extend([
        {"id": "open-config", "label": "Open config file", "icon": "󰈙",
         "command": [SELF, "open-config"], "closeOnDispatch": True},
        {"id": "edit-config-agent", "label": "Edit with agent", "icon": "󰚩",
         "command": [SELF, "edit-config-agent"], "closeOnDispatch": True},
    ])
    return rows


def override_visible(key, repository, settings, excluded, default):
    overrides = settings.get("overrides", {})
    if key in overrides:
        return overrides[key]
    if repository in excluded:
        return False
    return default


def global_search_menu():
    config = load_config()
    excluded = set(config["excludedRepositories"])
    rows = global_root_shortcuts() + starred_shortcuts()
    repository_settings = config["repositories"]
    issue_settings = config["issues"]
    pull_settings = config["pullRequests"]
    notification_settings = config["notifications"]
    repository_items = []
    issue_items = []
    pull_items = []
    notification_items = []
    viewer = ""
    with ThreadPoolExecutor(max_workers=5) as pool:
        jobs = {}
        if repository_settings["enabled"]:
            jobs["repositories"] = pool.submit(repository_data, True)
            if repository_settings["scope"] == "owned":
                jobs["viewer"] = pool.submit(cached_gh, "viewer", 300, "user", None, True)
        if issue_settings["enabled"]:
            jobs["issues"] = pool.submit(search_data, "issue", "", True)
        if pull_settings["enabled"]:
            jobs["pullRequests"] = pool.submit(search_data, "pr", "", True)
        if notification_settings["enabled"]:
            jobs["notifications"] = pool.submit(notification_data, "", True)
        if "repositories" in jobs: repository_items = jobs["repositories"].result()
        if "viewer" in jobs: viewer = compact(jobs["viewer"].result().get("login"), 128)
        if "issues" in jobs: issue_items = jobs["issues"].result().get("items", [])
        if "pullRequests" in jobs: pull_items = jobs["pullRequests"].result().get("items", [])
        if "notifications" in jobs: notification_items = jobs["notifications"].result()


    included_repositories = []
    seen_repositories = set()
    for item in repository_items:
        name = item.get("full_name", "")
        owned = repository_settings["scope"] == "visible" or item.get("owner", {}).get("login") == viewer
        default = repository_settings["enabled"] and owned and len(included_repositories) < repository_settings["limit"]
        if override_visible(name, name, repository_settings, excluded, default):
            included_repositories.append(repo_row(item))
            seen_repositories.add(name)
    for name, visible in repository_settings["overrides"].items():
        if visible and name not in seen_repositories:
            included_repositories.append(repo_row(cached_gh(f"repo:{name}", 60, f"repos/{name}")))
    rows.extend(included_repositories)

    for entity, kind in (("issues", "issue"), ("pullRequests", "pr")):
        settings = config[entity]
        candidates = (issue_items if kind == "issue" else pull_items) if settings["enabled"] else []
        included = []
        seen = set()
        for item in candidates:
            repository = repo_name_from_url(item.get("repository_url"))
            key = f"{repository}#{item.get('number', '')}"
            default = len(included) < settings["limit"]
            if override_visible(key, repository, settings, excluded, default):
                included.append(issue_row(item, kind))
                seen.add(key)
        for key, visible in settings["overrides"].items():
            if not visible or key in seen:
                continue
            repository, number = key.rsplit("#", 1)
            endpoint = f"repos/{repository}/{'pulls' if kind == 'pr' else 'issues'}/{number}"
            item = cached_gh(f"override:{kind}:{key}", 60, endpoint)
            item["repository_url"] = f"https://api.github.com/repos/{repository}"
            if kind == "pr": item["pull_request"] = {"url": endpoint}
            included.append(issue_row(item, kind))
        rows.extend(included)

    if notification_settings["enabled"]:
        rows.extend(notification_row(item) for item in notification_items[:notification_settings["limit"]]
                     if item.get("repository", {}).get("full_name", "") not in excluded)
    return rows[:100]


def repository_counts(name, force=False):
    with ThreadPoolExecutor(max_workers=3) as pool:
        issue_job = pool.submit(search_data, "issue", name, force)
        pull_job = pool.submit(search_data, "pr", name, force)
        notification_job = pool.submit(notification_data, name, force)
        issues = issue_job.result()
        pulls = pull_job.result()
        repo_notifications = notification_job.result()
        return (int(issues.get("total_count", len(issues.get("items", [])))),
                int(pulls.get("total_count", len(pulls.get("items", [])))),
                len(repo_notifications))


def repository_shortcut(name, section):
    definitions = {
        "overview": ("Overview", "󰋜", {"document": {"command": [SELF, "repo-document", name], "refreshCommand": [SELF, "repo-document", name, "--refresh"]}}),
        "issues": ("Issues", "󰅚", {"submenu": {"command": [SELF, "repo-issues", name], "refreshCommand": [SELF, "repo-issues", name, "--refresh"]}}),
        "pull-requests": ("Pull Requests", "󰘬", {"submenu": {"command": [SELF, "repo-pull-requests", name], "refreshCommand": [SELF, "repo-pull-requests", name, "--refresh"]}}),
        "notifications": ("Notifications", "󰂚", {"submenu": {"command": [SELF, "repo-notifications", name], "refreshCommand": [SELF, "repo-notifications", name, "--refresh"]}}),
        "actions": ("Actions", "󰑮", {"submenu": {"command": [SELF, "repo-actions", name], "refreshCommand": [SELF, "repo-actions", name, "--refresh"]}}),
    }
    label, icon, behavior = definitions[section]
    row = {"id": section, "label": label, "icon": icon, "globalSearch": False}
    row.update(behavior)
    return starrable(row, f"repo:{name}:{section}", f"{name} · {label}")


def global_root_shortcuts():
    aliases = {
        "general:repositories": ["repository", "repositories", "repo", "repos"],
        "general:issues": ["issue", "issues"],
        "general:pull-requests": ["pull request", "pull requests", "pr", "prs"],
        "general:notifications": ["notification", "notifications"],
    }
    rows = []
    for row in root_menu()[:4]:
        row["label"] = row["starredLabel"]
        row["aliases"] = aliases[row["id"]]
        row["globalSearch"] = True
        rows.append(row)
    return rows


def starred_shortcuts():
    rows = []
    for key in sorted(load_stars()):
        if key.startswith("repository:"):
            row = repo_row({"full_name": key[len("repository:"):]})
        elif key.startswith("repo:"):
            repository, section = key[5:].rsplit(":", 1)
            row = repository_shortcut(repository, section)
        else:
            continue
        row["globalSearch"] = True
        rows.append(row)
    return rows


def repository_menu(name, force=False):
    url = f"https://github.com/{name}"
    issue_count, pull_count, notification_count = repository_counts(name, force)
    overview = repository_shortcut(name, "overview")
    issues = repository_shortcut(name, "issues")
    issues["badge"] = str(issue_count)
    pulls = repository_shortcut(name, "pull-requests")
    pulls["badge"] = str(pull_count)
    repo_notifications = repository_shortcut(name, "notifications")
    repo_notifications["badge"] = "100+" if notification_count >= 100 else str(notification_count)
    actions = repository_shortcut(name, "actions")
    return [
        overview, issues, pulls, repo_notifications, actions,
        {"id": "open", "label": "Open on GitHub", "icon": "󰖟", "command": ["xdg-open", url], "closeOnSuccess": True},
        {"id": "copy-url", "label": "Copy URL", "icon": "󰆏", "command": ["wl-copy", "--", url]},
    ]


def emit(value):
    json.dump(value, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")


def repo_document(name):
    item = gh(f"repos/{name}")
    url = item.get("html_url") or f"https://github.com/{name}"
    topics = [compact(topic, 64) for topic in item.get("topics", []) if compact(topic, 64)]
    sections = [{"heading": "Topics", "text": "  ·  ".join(topics)}] if topics else []
    return {
        "title": item.get("full_name") or name, "subtitle": compact(item.get("description")),
        "icon": "󰊢",
        "status": "Archived" if item.get("archived") else ("Private" if item.get("private") else "Public"),
        "stats": [
            {"label": "Stars", "value": str(item.get("stargazers_count", 0)), "icon": "󰓎"},
            {"label": "Forks", "value": str(item.get("forks_count", 0)), "icon": "󰘬"},
            {"label": "Open issues", "value": str(item.get("open_issues_count", 0)), "icon": "󰅚"},
        ],
        "fields": [
            {"label": "Owner", "value": compact(item.get("owner", {}).get("login"))},
            {"label": "Language", "value": compact(item.get("language")) or "—"},
            {"label": "Default branch", "value": compact(item.get("default_branch"))},
            {"label": "Updated", "value": date(item.get("updated_at"))},
        ],
        "sections": sections, "actions": [action_open(url), action_copy(url)],
    }


def issue_document(repo, number):
    item = gh(f"repos/{repo}/issues/{number}")
    url = item.get("html_url", "")
    labels = ", ".join(label.get("name", "") for label in item.get("labels", [])) or "—"
    assignees = ", ".join(user.get("login", "") for user in item.get("assignees", [])) or "—"
    return {
        "title": item.get("title") or f"Issue #{number}", "subtitle": f"{repo} #{number}", "icon": "󰅚",
        "status": compact(item.get("state"), 64).title(),
        "fields": [
            {"label": "Author", "value": compact(item.get("user", {}).get("login"))},
            {"label": "Assignees", "value": assignees}, {"label": "Labels", "value": labels},
            {"label": "Comments", "value": str(item.get("comments", 0))},
            {"label": "Created", "value": date(item.get("created_at"))},
            {"label": "Updated", "value": date(item.get("updated_at"))},
        ],
        "sections": [{"heading": "Description", "text": (item.get("body") or "No description.")[:32768], "format": "markdown"}],
        "actions": [action_open(url), action_copy(url)],
    }


def combined_status(value):
    if isinstance(value, dict):
        return compact(value.get("state"), 64).title() or "Unknown"
    if not isinstance(value, list) or not value:
        return "Unknown"
    states = [compact(item.get("state"), 64).lower() for item in value if isinstance(item, dict)]
    if any(state in ("failure", "error") for state in states):
        return "Failure"
    if any(state in ("pending", "queued", "in_progress") for state in states):
        return "Pending"
    if states and all(state == "success" for state in states):
        return "Success"
    return "Unknown"


def pr_document(repo, number):
    item = gh(f"repos/{repo}/pulls/{number}")
    statuses = []
    check_runs = []
    if item.get("statuses_url"):
        try:
            statuses = gh(api_path(item["statuses_url"]))
        except SystemExit:
            statuses = []
    head_sha = item.get("head", {}).get("sha")
    if head_sha:
        try:
            check_runs = gh(f"repos/{repo}/commits/{head_sha}/check-runs", {"per_page": "100"}).get("check_runs", [])
        except SystemExit:
            check_runs = []
    presentations = [status_presentation(run.get("status"), run.get("conclusion")) for run in check_runs]
    passed = sum(label == "Success" for label, _, _ in presentations)
    failed = sum(label == "Failure" for label, _, _ in presentations)
    pending = sum(label == "Pending" for label, _, _ in presentations)
    check_summary = " · ".join(part for part in (
        f"{passed} passed" if passed else "", f"{failed} failed" if failed else "",
        f"{pending} pending" if pending else "") if part) or combined_status(statuses)
    check_lines = []
    for run, presentation in zip(check_runs, presentations):
        label, _, marker = presentation
        check_lines.append(f"- {marker} {compact(run.get('name') or 'Check', 180)} — {label}")
    url = item.get("html_url", "")
    reviewers = ", ".join(user.get("login", "") for user in item.get("requested_reviewers", [])) or "—"
    state = "Draft" if item.get("draft") else ("Merged" if item.get("merged") else compact(item.get("state")).title())
    sections = []
    if check_lines:
        sections.append({"heading": "Checks", "text": "\n".join(check_lines), "format": "markdown"})
    sections.append({"heading": "Description", "text": (item.get("body") or "No description.")[:32768], "format": "markdown"})
    return {
        "title": item.get("title") or f"Pull request #{number}", "subtitle": f"{repo} #{number}", "icon": "󰘬", "status": state,
        "fields": [
            {"label": "Author", "value": compact(item.get("user", {}).get("login"))},
            {"label": "Reviewers", "value": reviewers},
            {"label": "Checks", "value": check_summary},
            {"label": "Branches", "value": f"{compact(item.get('head', {}).get('ref'))} → {compact(item.get('base', {}).get('ref'))}"},
            {"label": "Changes", "value": f"+{item.get('additions', 0)} −{item.get('deletions', 0)} in {item.get('changed_files', 0)} files"},
            {"label": "Mergeable", "value": str(item.get("mergeable", "unknown")).title()},
            {"label": "Created", "value": date(item.get("created_at"))},
            {"label": "Updated", "value": date(item.get("updated_at"))},
        ],
        "sections": sections,
        "actions": [action_open(url), action_copy(url)],
    }


def notification_document(thread):
    item = gh(f"notifications/threads/{thread}")
    subject = item.get("subject") or {}
    related = {}
    if subject.get("url"):
        related = gh(api_path(subject["url"]))
    repo = (item.get("repository") or {}).get("full_name", "")
    url = related.get("html_url") or (item.get("repository") or {}).get("html_url") or f"https://github.com/{repo}"
    actions = [action_open(url), action_copy(url), {
        "id": "mark-read", "label": "Mark as read", "command": [SELF, "mark-read", thread]
    }]
    return {
        "title": subject.get("title") or "GitHub notification", "subtitle": repo, "icon": "󰂚",
        "status": "Unread" if item.get("unread", True) else "Read",
        "fields": [
            {"label": "Reason", "value": compact(item.get("reason")).replace("_", " ").title()},
            {"label": "Type", "value": compact(subject.get("type"))},
            {"label": "Author", "value": compact(related.get("user", {}).get("login")) or "—"},
            {"label": "Updated", "value": date(item.get("updated_at"))},
        ],
        "sections": [{"heading": "Description", "text": (related.get("body") or "No description is available.")[:32768], "format": "markdown"}],
        "actions": actions,
    }


def action_run_document(repo, run_id):
    run = gh(f"repos/{repo}/actions/runs/{run_id}")
    jobs = gh(f"repos/{repo}/actions/runs/{run_id}/jobs", {"per_page": "100"}).get("jobs", [])
    label, _, _ = status_presentation(run.get("status"), run.get("conclusion"))
    job_lines = []
    for job in jobs:
        job_label, _, marker = status_presentation(job.get("status"), job.get("conclusion"))
        duration = ""
        if job.get("started_at") and job.get("completed_at"):
            try:
                started = datetime.fromisoformat(job["started_at"].replace("Z", "+00:00"))
                completed = datetime.fromisoformat(job["completed_at"].replace("Z", "+00:00"))
                duration = f" · {max(0, int((completed - started).total_seconds()))}s"
            except ValueError:
                duration = ""
        job_lines.append(f"- {marker} {compact(job.get('name') or 'Job', 180)} — {job_label}{duration}")
    url = run.get("html_url") or f"https://github.com/{repo}/actions/runs/{run_id}"
    actor = run.get("actor") or run.get("triggering_actor") or {}
    return {
        "title": run.get("name") or run.get("display_title") or f"Workflow run {run_id}",
        "subtitle": f"{repo} · Run #{run.get('run_number', run_id)}", "icon": "󰑮", "status": label,
        "fields": [
            {"label": "Branch", "value": compact(run.get("head_branch")) or "—"},
            {"label": "Commit", "value": compact(run.get("head_sha"), 12) or "—"},
            {"label": "Event", "value": compact(run.get("event")).replace("_", " ") or "—"},
            {"label": "Actor", "value": compact(actor.get("login")) or "—"},
            {"label": "Created", "value": date(run.get("created_at"))},
            {"label": "Updated", "value": date(run.get("updated_at"))},
        ],
        "sections": [{"heading": "Jobs", "text": "\n".join(job_lines) if job_lines else "No jobs are available.",
                      "format": "markdown"}],
        "actions": [action_open(url), action_copy(url)],
    }


def main():
    args = sys.argv[1:]
    force = bool(args and args[-1] == "--refresh")
    if force:
        args = args[:-1]
    command = args[0] if args else "menu"
    if command in ("menu", "root"): emit(root_menu())
    elif command == "configuration": emit(configuration_menu())
    elif command == "open-config": open_config_with_editor()
    elif command == "edit-config-agent": edit_config_with_agent()
    elif command == "global-search": emit(global_search_menu())
    elif command == "preload": emit(preload_menu(force))
    elif command == "repositories": emit(repositories(80, force))
    elif command == "issues": emit(search_rows("issue", 80, "", force))
    elif command == "pull-requests": emit(search_rows("pr", 80, "", force))
    elif command == "notifications": emit(notifications(80, "", force))
    elif command == "repository" and len(args) == 2: emit(repository_menu(args[1], force))
    elif command == "repo-issues" and len(args) == 2: emit(search_rows("issue", 80, args[1], force))
    elif command == "repo-pull-requests" and len(args) == 2: emit(search_rows("pr", 80, args[1], force))
    elif command == "repo-notifications" and len(args) == 2: emit(notifications(80, args[1], force))
    elif command == "repo-actions" and len(args) == 2: emit(action_runs(args[1], 30, force))
    elif command == "action-run-document" and len(args) == 3: emit(cached_value(
        f"action-run:{args[1]}:{args[2]}", 30, force, lambda: action_run_document(args[1], args[2])))
    elif command == "repo-document" and len(args) == 2: emit(cached_value(
        f"repo-document:{args[1]}", 30, force, lambda: repo_document(args[1])))
    elif command == "issue-document" and len(args) == 3: emit(cached_value(
        f"issue-document:{args[1]}:{args[2]}", 30, force, lambda: issue_document(args[1], args[2])))
    elif command == "pr-document" and len(args) == 3: emit(cached_value(
        f"pr-document:{args[1]}:{args[2]}", 30, force, lambda: pr_document(args[1], args[2])))
    elif command == "notification-document" and len(args) == 2: emit(cached_value(
        f"notification-document:{args[1]}", 30, force, lambda: notification_document(args[1])))
    elif command == "mark-read" and len(args) == 2:
        gh(f"notifications/threads/{args[1]}", method="PATCH")
        clear_cache()
    elif command == "set-star" and len(args) == 3: set_star(args[1], args[2])
    else: fail("invalid command")


if __name__ == "__main__":
    main()
